func factorial(n) {
    if n == 0 {
        return 1;
    }

    return n * factorial(n - 1);
}

func sumArray(numbers) {
    let total = 0;
    let i = 0;

    while i < 5 {
        total = total + numbers[i];
        i = i + 1;
    }

    return total;
}

func countUp(limit) {
    let i = 0;

    while i < limit {
        print(i);
        i = i + 1;
    }

    return i;
}


